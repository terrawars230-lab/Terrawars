# ─────────────────────────────────────────────────────────────────────────────
#  TerraWars — environment template
#
#  Copy to `.env` (local dev), `.env.staging`, `.env.production` and fill in.
#  Read at BUILD time by react-native-config and injected into JS, the Android
#  manifest and the iOS Info.plist. Changing a value requires a rebuild
#  (`npm run android` / `npm run ios`), not just a Metro reload.
#
#  NEVER commit a filled-in .env. Only this template is tracked.
#  NEVER put the Supabase service-role key here — it would ship inside the APK.
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this build points at: development | staging | production
APP_ENV=development

# App display name shown under the launcher icon.
APP_DISPLAY_NAME=TerraWars

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is a public client key; RLS is what
# actually protects the data (doc 04 §6).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Google Maps ─────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials.
# Use two separate restricted keys:
#   Android key → restricted to the SHA-1 + package com.terrawars
#   iOS key     → restricted to the bundle id com.terrawars
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# ── Google Sign-In (FR-01) ──────────────────────────────────────────────────
# OAuth 2.0 Web client id from Google Cloud Console. The SAME web client id
# goes into Supabase Auth → Providers → Google.
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=

# ── Public pages the stores require (docs/store/README.md) ─────────────────
# Must be live, public URLs before submission. Linked from sign-up, Settings
# and the store listings. Hostable pages are in docs/store/legal/.
PRIVACY_POLICY_URL=https://terrawars.app/privacy
TERMS_URL=https://terrawars.app/terms
ACCOUNT_DELETION_URL=https://terrawars.app/delete-account
SUPPORT_EMAIL=support@terrawars.app

# Where the sign-up confirmation LINK lands after verifying the address (the
# app itself confirms with the emailed 6-digit code). Add the same URL under
# Supabase → Auth → URL Configuration → Redirect URLs. Blank = Site URL.
AUTH_EMAIL_REDIRECT_URL=https://terrawars.app/email-confirmed

# ── Observability (optional; leave blank to disable) ────────────────────────
SENTRY_DSN=

# ── Tuning ──────────────────────────────────────────────────────────────────
API_TIMEOUT_MS=15000
# Verbose network + location logs. Ignored (forced off) when APP_ENV=production.
DEBUG_LOGGING=true
