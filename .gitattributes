# Normalise line endings so a Windows checkout and a macOS/Linux CI run produce
# identical blobs. Without this, every file touched on Windows shows as fully
# rewritten in the next diff.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or they will not run.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets: never transform, never diff as text.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.jar     binary
*.keystore binary
*.ttf     binary
*.otf     binary
*.aab     binary
*.apk     binary

# Generated: collapse in review, but still tracked for reproducible installs.
package-lock.json linguist-generated=true -diff
