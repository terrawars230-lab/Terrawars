def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-permissions v5 compiles in ONLY the handlers listed here. Without
# this call every request() rejects with "No permission handler detected", so
# the location rationale's "Allow" button did nothing on iOS and a walk could
# never start. Keep this list in step with src/services/permissions and the
# purpose strings in Info.plist:
#   LocationWhenInUse — the walk (FR-10); never "Always" (ADR D-04).
#   LocationAccuracy  — temporary full accuracy when Precise Location is off.
# Motion and Notifications are deliberately absent until the features that use
# them exist (doc 06 §2 step counter, FR-70 raid pushes).
setup_permissions([
  'LocationWhenInUse',
  'LocationAccuracy',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TerraWars' do
  config = use_native_modules!

  # react-native-maps renders through the Google Maps iOS SDK so Android and
  # iOS show the same tiles and the same styling. Without this pod the map
  # silently falls back to Apple Maps, which looks different enough that a
  # design that works on one platform looks wrong on the other.
  rn_maps_path = '../node_modules/react-native-maps'
  pod 'react-native-google-maps', :path => rn_maps_path

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
