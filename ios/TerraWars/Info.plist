<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>TerraWars</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
	  <!-- Do not change NSAllowsArbitraryLoads to true, or you will risk app rejection! -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- doc 06 §5: a bare permission dialog is both a policy risk and the main
	     cause of first-session drop-off. The full-screen rationale is shown by
	     the app BEFORE this dialog; this string is the one-line reminder. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TerraWars records your route only while a walk is running, so it can work out the area you enclosed. Other players never see your route or live position.</string>

	<!--
	  NSLocationAlwaysAndWhenInUseUsageDescription is deliberately ABSENT.
	  ADR D-04 / CLAUDE.md rule 5: no background location. When-In-Use plus the
	  `location` background mode keeps an active walk recording with the screen
	  off, which is all we need.
	-->

	<!-- Required for CLLocationManager.allowsBackgroundLocationUpdates, which
	     is what keeps a walk recording when the screen locks mid-route. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<!-- doc 06 §2: the step-counter cross-check. -->
	<key>NSMotionUsageDescription</key>
	<string>TerraWars compares your step count with your recorded route to confirm the walk really happened.</string>

	<!-- Deep links: OAuth callback and FR-42 raid notifications. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.terrawars</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>terrawars</string>
			</array>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
