<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>TerraWars</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
	  <!-- Do not change NSAllowsArbitraryLoads to true, or you will risk app rejection! -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- doc 06 §5: a bare permission dialog is both a policy risk and the main
	     cause of first-session drop-off. The full-screen rationale is shown by
	     the app BEFORE this dialog; this string is the one-line reminder. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TerraWars records your route only while a walk is running — including when your screen is locked during that walk — to work out the territory you enclose. Other players never see your route or your live position.</string>

	<!-- iOS 14+: with "Precise Location" off, the app asks for temporary full
	     accuracy for the walk (requestLocationAccuracy, purpose key
	     WalkTracking). An approximate fix kilometres wide cannot trace a walk. -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>WalkTracking</key>
		<string>A walk needs your precise location to trace your route and measure the territory you enclose.</string>
	</dict>

	<!--
	  NSLocationAlwaysAndWhenInUseUsageDescription is deliberately ABSENT.
	  ADR D-04 / CLAUDE.md rule 5: no background location. When-In-Use plus the
	  `location` background mode keeps an active walk recording with the screen
	  off, which is all we need.
	-->

	<!-- Required for CLLocationManager.allowsBackgroundLocationUpdates, which
	     is what keeps a walk recording when the screen locks mid-route. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>

	<!--
	  NSMotionUsageDescription is deliberately absent. The doc 06 §2 step-count
	  cross-check is not built yet, and App Review rejects a purpose string for
	  a permission the app never uses. Add it back with that feature.
	-->

	<!-- Deep links: OAuth callback and FR-42 raid notifications. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.terrawars</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>terrawars</string>
			</array>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<!-- The game is played by walking with GPS; mirrors Android's
		     required android.hardware.location.gps feature. -->
		<string>location-services</string>
		<string>gps</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- Nocturne is dark-only: system chrome (alerts, keyboards, pickers) and
	     the status bar match it from the first frame. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<!-- Export compliance: the app uses only the encryption built into the OS
	     (HTTPS/TLS), which is exempt. Without this key every TestFlight and App
	     Store upload stops to ask. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
