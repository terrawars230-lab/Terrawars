!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ─────────────────────────────────────────────────────────────────────────────
# Secrets. CLAUDE.md rule 8: no service-role keys, tile API keys or FCM
# credentials are ever committed. Only .env.example (all-blank) is tracked.
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# Local MCP config — carries a Supabase personal access token (sbp_…).
.mcp.json

# Firebase / FCM config (added in Phase 5). These carry project identifiers and
# API keys and must be supplied per-developer, not committed.
android/app/google-services.json
ios/GoogleService-Info.plist
ios/TerraWars/GoogleService-Info.plist

# Release signing. `!debug.keystore` above keeps the shared debug key, which is
# public by design; a release keystore must never be here.
*.jks
release.keystore
android/keystore.properties

# Supabase CLI credentials
.supabase/config.json

# Supabase local dev
supabase/.branches
supabase/.temp
.supabase/

# Generated
coverage/
*.tsbuildinfo
