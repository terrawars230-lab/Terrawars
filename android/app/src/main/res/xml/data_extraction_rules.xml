<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the device through cloud backup or a
     device-to-device transfer. The app's storage holds the Supabase session
     tokens and in-progress GPS walks (doc 06 §4); `allowBackup="false"` alone
     stops cloud backup but NOT device-to-device transfer on Android 12+. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
