<resources>

    <!-- Base application theme.

         Dark, like the app: Nocturne is dark-only (see ThemeProvider.tsx). A
         DayNight parent painted a white window before the first JS frame on
         any phone in light mode — a white flash on every launch — and drew
         native alerts in light chrome over a dark app. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="colorPrimary">@color/brand_surface</item>
        <item name="colorAccent">@color/brand_accent</item>
        <!-- Light status- and navigation-bar icons over the dark UI, from the
             very first frame (edge-to-edge draws behind both bars). -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>
